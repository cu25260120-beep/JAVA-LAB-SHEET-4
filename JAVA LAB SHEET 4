Q26. Create a class Matrix with fields for 2×2 matrix and a class variable matrixType. Use local variables to add and subtract two matrices.

Program:

class Matrix {
    int[][] a = {{1, 2}, {3, 4}};
    int[][] b = {{5, 6}, {7, 8}};
    static String matrixType = "2x2 Matrix";

    void calculate() {
        int[][] sum = new int[2][2];
        int[][] diff = new int[2][2];

        for (int i = 0; i < 2; i++)
            for (int j = 0; j < 2; j++) {
                sum[i][j] = a[i][j] + b[i][j];
                diff[i][j] = a[i][j] - b[i][j];
            }

        System.out.println("Addition:");
        for (int[] row : sum) {
            for (int n : row) System.out.print(n + " ");
            System.out.println();
        }

        System.out.println("Subtraction:");
        for (int[] row : diff) {
            for (int n : row) System.out.print(n + " ");
            System.out.println();
        }
    }

    public static void main(String[] args) {
        new Matrix().calculate();
    }
}

Output:

Addition:
6 8
10 12
Subtraction:
-4 -4
-4 -4
